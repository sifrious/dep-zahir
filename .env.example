APP_NAME=Zahir
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://zahir.test

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=sqlite
SESSION_DRIVER=array
CACHE_STORE=array
QUEUE_CONNECTION=sync

ZAHIR_MAXIMUM_REQUEST_BYTES=32768
ZAHIR_REQUESTS_PER_MINUTE=120
ZAHIR_IDENTITY_LINK_MAX_AGE_SECONDS=600
ZAHIR_SEED_DEVELOPMENT_GRANTS=false
